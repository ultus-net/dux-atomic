[Unit]
Description=Default the Dux greeter to the Niri session
Documentation=https://github.com/duxlabs-dev/dux-greeter
# The greeter picks index 0 when it has no remembered session, and the
# desktop-file load order is asynchronous. Seed Niri so the first login is
# deterministic. A remembered choice on a later boot wins.
ConditionPathExists=!/var/cache/dms-greeter/.local/state/memory.json
Before=greetd.service

[Service]
Type=oneshot
# The package tmpfiles rule owns /var/cache/dms-greeter. Create the state
# directory if absent; install -d also makes the cache root, so the rule still
# sets its final mode and owner on the next boot.
ExecStartPre=/usr/bin/install -d -m 0755 -o greeter -g greeter /var/cache/dms-greeter/.local/state
ExecStart=/usr/bin/install -m 0644 -o greeter -g greeter /usr/share/dux-atomic/greeter/memory.json /var/cache/dms-greeter/.local/state/memory.json

[Install]
WantedBy=greetd.service
